# Production template for docker-compose (see INSTALL.md). Local development uses .env.example.
# Copy to .env (chmod 600) and fill in. Never commit .env.

# --- Domain / TLS -------------------------------------------------------------------------
CADERLY_BASE_DOMAIN=caderly.app
# Let's Encrypt expiry notices go here.
ACME_EMAIL=you@example.com
# Cloudflare token with "Edit zone DNS" on the zone above (wildcard certificate, DNS-01).
CLOUDFLARE_API_TOKEN=

# --- Database (native Postgres on the host) -------------------------------------------------
DB_NAME=caderly
DB_USER=caderly
DB_PASSWORD=

# --- Mail ----------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
CADERLY_EMAIL_FROM=no-reply@caderly.app

# --- Secrets -------------------------------------------------------------------------------
# AES-256-GCM key for encrypted columns: base64 of 32 random bytes.  openssl rand -base64 32
# Losing it makes the encrypted data unreadable: back it up separately from the database.
CADERLY_EMPLOYEE_ENCRYPTION_KEY=

# --- Features / Super Admin ----------------------------------------------------------------
CADERLY_SIGNUP_ENABLED=false
# Provisions the first Super Admin at startup when both are set; remove the password afterwards.
CADERLY_SUPERADMIN_EMAIL=
CADERLY_SUPERADMIN_PASSWORD=
# CIDRs allowed to reach /superadmin. Empty means nobody (fails closed).
CADERLY_SUPERADMIN_IP_ALLOWLIST=

# --- Storage -------------------------------------------------------------------------------
CADERLY_FILES_DIR=/var/lib/caderly/files
