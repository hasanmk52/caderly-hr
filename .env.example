# Copy to .env and fill in real values for local development.
# Spring Boot does not load .env files automatically — export these
# before running, e.g.: export $(grep -v '^#' .env | xargs)

# Postgres role that owns the helyx database / helyx_hr schema.
DB_USER=helyx
# Empty by default for first-run trust-auth local setups. Set a real
# password once you configure Postgres to require one.
DB_PASSWORD=

# AES-256 key for CryptoConverter (government IDs, bank details, compensation
# — ADR 0008). Base64-encoded, 32 raw bytes. Generate with:
#   openssl rand -base64 32
# Must stay stable forever once real data is encrypted with it — there is no
# key rotation yet, so losing or replacing this value makes existing
# encrypted rows permanently unreadable. Back it up somewhere durable outside
# the server before using this against real data.
HELYX_EMPLOYEE_ENCRYPTION_KEY=
